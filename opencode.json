{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".claude/skills/*/SKILL.md"
  ],
  "plugins": [
    "@dietrichgebert/ponytail@5.3.3"
  ],
  "mcp": {
    "dart": {
      "type": "local",
      "command": [
        "dart",
        "mcp-server"
      ],
      "environment": {
        "AGENT_PLUGIN": "opencode"
      },
      "enabled": true
    },
    "sentry": {
      "type": "local",
      "command": [
        "sentry-mcp"
      ]
    },
    "scaleway": {
      "type": "local",
      "command": [
        "scw-mcp"
      ]
    }
  }
}
