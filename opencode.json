{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".claude/skills/*/SKILL.md"
  ],
  "plugins": [
    "@dietrichgebert/ponytail@5.3.3"
  ],
  "mcp": {
    "dart": {
      "type": "local",
      "command": [
        "dart",
        "mcp-server"
      ],
      "environment": {
        "AGENT_PLUGIN": "opencode"
      },
      "enabled": true
    },
    "sentry": {
      "type": "local",
      "command": [
        "sentry-mcp"
      ]
    },
    "scaleway": {
      "type": "local",
      "command": [
        "scw-mcp"
      ]
    }
  },
  "agents": {
    "po": {
      "mode": "primary",
      "model": "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
      "permission": {
        "skill": {
          "codegraph": "deny",
          "ponytail": "deny"
        }
      }
    },
    "architect": {
      "mode": "primary",
      "model": "openrouter/poolside/laguna-s-2.1:free",
      "permission": {
        "skill": {
          "codegraph": "allow",
          "ponytail": "ask"
        }
      }
    },
    "developer": {
      "mode": "primary",
      "model": "openrouter/poolside/laguna-s-2.1:free",
      "permission": {
        "skill": {
          "codegraph": "allow",
          "ponytail": "allow"
        }
      }
    }
  }
}