{
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "enabledMcpjsonServers": [
    "codegraph",
    "dart",
    "sentry"
  ],
  "statusLine": {
    "type": "command",
    "command": "f=\"$HOME/.claude/ponytail-statusline.sh\"; if [ -f \"$f\" ]; then bash \"$f\"; else echo '[PONYTAIL NOT INSTALLED]'; fi"
  },
  "permissions": {
    "allow": [
      "mcp__codegraph__*",
      "mcp__dart__*",
      "mcp__sentry__*"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ]
  }
}
