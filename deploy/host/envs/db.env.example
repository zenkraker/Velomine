# The same database as app.env, for pg_dump, the demo baseline and reset. Copy to envs/<env>/db.env (git-ignored).
# On the host it is /etc/velomine/<env>/db.env, readable by root only (deploy/host/README.md).
PGHOST=REPLACE_WITH_DB_PRIVATE_IP
PGPORT=5432
PGDATABASE=velomine_ENV
PGUSER=velomine_ENV
PGPASSWORD=REPLACE_WITH_DB_PASSWORD
