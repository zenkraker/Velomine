# One environment's server settings. Copy to envs/<env>/app.env (git-ignored) and fill it from `tofu output` and your
# secret store. deploy.sh installs it as /etc/velomine/<env>/app.env. Every setting is in the README settings table.

# The database host is the private IP of the managed instance (tofu output envs_db_host, or db_host for the demo).
# Each environment has its own database and user, which cannot connect to another environment's database.
ConnectionStrings__Velomine=Host=REPLACE_WITH_DB_HOST;Port=5432;Database=velomine_ENV;Username=velomine_ENV;Password=REPLACE_WITH_DB_PASSWORD

# The address members open. deploy.sh reads the host name from here for Caddy and the health checks.
Velomine__PublicUrl=https://ENV.velomine.eu
Velomine__Admin__Email=admin@example.com
Velomine__Admin__Password=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# Sentry is optional; with an empty DSN, telemetry stays off. Name the environment so events are told apart.
Velomine__Telemetry__Enabled=true
Velomine__Telemetry__Sentry__Dsn=
Velomine__Telemetry__Sentry__Environment=ENV

# Email and single sign-on are optional.
# Velomine__Smtp__Host=
# Velomine__Smtp__Port=587
# Velomine__Smtp__Security=starttls
# Velomine__Smtp__User=
# Velomine__Smtp__Password=
# Velomine__Smtp__From=Velomine <velomine@example.com>
# Velomine__Sso__Authority=
# Velomine__Sso__ClientId=
# Velomine__Sso__ClientSecret=
