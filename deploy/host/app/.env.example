# One environment's compose settings: copy to the host as /opt/velomine/<env>/.env and edit it there. Nothing in it is
# secret; the secrets are in app.env next to it.

# demo, dev, staging or prod. It names the compose project, the network, the Traefik router and /srv/velomine/<env>.
VELOMINE_ENV=demo

# The release both images run: X.Y.Z from a tag vX.Y.Z (never latest). Change it and run
# `docker compose pull && docker compose up -d --wait` to release or roll back.
VELOMINE_VERSION=0.1.0

# The host names Traefik sends to this environment. The demo also answers velomine.eu and www until prod launches;
# then they move to prod's rule. Examples for the others:
#   dev      'Host(`dev.velomine.eu`)'
#   staging  'Host(`staging.velomine.eu`)'
#   prod     'Host(`app.velomine.eu`) || Host(`velomine.eu`) || Host(`www.velomine.eu`)'
VELOMINE_ROUTER_RULE='Host(`demo.velomine.eu`) || Host(`velomine.eu`) || Host(`www.velomine.eu`)'

# HTTPS-only for a year; dev and staging add noindex: hsts@docker,noindex@docker
VELOMINE_MIDDLEWARES=hsts@docker
