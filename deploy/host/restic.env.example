# The backup repository, shared by every host: each snapshot carries its host name and its environment as a tag.
# Copy to restic.env (git-ignored). On the host it is /etc/velomine/restic.env, readable by root only.
# The key is the host's IAM application key (infra/README.md, "Host credentials"), never the account key.
RESTIC_REPOSITORY=s3:https://s3.fr-par.scw.cloud/REPLACE_WITH_BUCKET/restic
RESTIC_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
AWS_ACCESS_KEY_ID=REPLACE_WITH_SCW_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SCW_SECRET_KEY
AWS_DEFAULT_REGION=fr-par

# The environments backup.sh saves, separated by spaces.
BACKUP_ENVS="demo"
