# Copy to velomine.env and fill from `tofu output` plus your secret store.
# Never commit velomine.env.

ConnectionStrings__Velomine=Host=REPLACE_WITH_DB_HOST;Port=5432;Database=velomine;Username=velomine_app;Password=REPLACE_WITH_DB_PASSWORD

# The address members reach this club at: used in password reset links and required at startup.
Velomine__PublicUrl=https://demo.velomine.eu
Velomine__FilesPath=/data/files
Velomine__DataProtection__KeysPath=/data/keys
Velomine__Admin__Email=admin@example.com
Velomine__Admin__Password=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# Sentry is optional; with an empty DSN, telemetry stays off.
Velomine__Telemetry__Enabled=true
Velomine__Telemetry__Sentry__Dsn=
Velomine__Telemetry__Sentry__Environment=demo

# Email and single sign-on are optional for the demo.
# Velomine__Smtp__Host=
# Velomine__Smtp__Port=587
# Velomine__Smtp__Security=starttls
# Velomine__Smtp__User=
# Velomine__Smtp__Password=
# Velomine__Smtp__From=Velomine <velomine@example.com>
# Velomine__Sso__Authority=
# Velomine__Sso__ClientId=
# Velomine__Sso__ClientSecret=
