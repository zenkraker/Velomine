{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ],
      "alwaysLoad": true
    },
    "dart": {
      "type": "stdio",
      "command": "dart",
      "args": [
        "mcp-server"
      ],
      "env": {
        "AGENT_PLUGIN": "claude-code"
      },
      "alwaysLoad": true
    },
    "sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp?skills=inspect,triage"
    },
    "playwright": {
      "type": "stdio",
      "command": "playwright-mcp",
      "args": [
        "--config",
        "tools/playwright-mcp.json"
      ]
    },
    "scaleway": {
      "type": "stdio",
      "command": "scw",
      "args": [
        "-p",
        "velomine-readonly",
        "mcp",
        "server",
        "serve",
        "read-only=true",
        "namespaces=instance,rdb,dns,object,iam,registry,vpc"
      ]
    }
  }
}
