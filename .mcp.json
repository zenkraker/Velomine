{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ],
      "alwaysLoad": true
    },
    "dart": {
      "type": "stdio",
      "command": "dart",
      "args": [
        "mcp-server"
      ],
      "env": {
        "AGENT_PLUGIN": "claude-code"
      },
      "alwaysLoad": true
    },
    "sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp?skills=inspect,triage"
    }
  }
}
