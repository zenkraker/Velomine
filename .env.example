# Every setting Velomine reads, with its default. Copy this file to .env next to docker-compose.yml and change what you
# need; .env is git-ignored and every variable in it reaches the server. A commented-out line keeps its default.
#
# Names: upper case, with __ for a nested setting (VELOMINE__SMTP__HOST is the server's Velomine:Smtp:Host).
# The README ("Settings you can change") explains each one.

# ---------------------------------------------------------------------------------------------------------------------
# Compose: which files, which images, which port
# ---------------------------------------------------------------------------------------------------------------------

# The compose files plain `docker compose` commands use. A public server behind Traefik (the demo):
# COMPOSE_FILE=docker-compose.yml:compose.demo.yaml

# The published images to run (ghcr.io/zenkraker/velomine-{server,web}). Unset, `docker compose up --build` builds
# them from source as `dev`. Never `latest`.
# VELOMINE_VERSION=0.1.0

# The host port of the web image. Not used with compose.demo.yaml, where Traefik answers on 80 and 443.
# VELOMINE_PORT=8080

# compose.demo.yaml only: the app's host name (its DNS points at this server) and Let's Encrypt's contact.
# VELOMINE_DOMAIN=demo.velomine.eu
# Optional second name serving only the presentation site; anything else redirects to VELOMINE_DOMAIN.
# VELOMINE_SITE_DOMAIN=velomine.eu
# VELOMINE_ACME_EMAIL=ops@example.org

# ---------------------------------------------------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------------------------------------------------

# Set before the first start: the database keeps its first password afterwards.
POSTGRES_PASSWORD=change-me

# An existing PostgreSQL server instead of the postgres container. Unset, the server uses the container.
# CONNECTIONSTRINGS__VELOMINE=Host=db.example;Database=velomine;Username=velomine;Password=...

# ---------------------------------------------------------------------------------------------------------------------
# The server's address and first admin
# ---------------------------------------------------------------------------------------------------------------------

# The address members open: password reset links and calendar feed addresses. The Host header is never used.
VELOMINE__PUBLICURL=http://localhost:8080

# The first admin, created on start while the server has none. Ignored afterwards.
VELOMINE__ADMIN__EMAIL=admin@velomine.local
VELOMINE__ADMIN__PASSWORD=change-me

# ---------------------------------------------------------------------------------------------------------------------
# Accounts and clubs. A value saved by an admin in the app (Admin, Settings) wins over these.
# ---------------------------------------------------------------------------------------------------------------------

# VELOMINE__ACCOUNTS__SIGNUPENABLED=true
# VELOMINE__ACCOUNTS__REQUIREADMINAPPROVAL=true
# VELOMINE__ACCOUNTS__CLUBCREATIONENABLED=false

# ---------------------------------------------------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------------------------------------------------

# Largest Strava export accepted, in MB.
# VELOMINE__IMPORTS__MAXARCHIVEMB=1024

# Per address, a minute: sign-in, sign-up, two-factor, password reset and the phone's single sign-on.
# VELOMINE__RATELIMITS__ANONYMOUSPERMINUTE=60
# Per member: ride files an hour (sustained), ride files at once, Strava imports a day, clubs started a day.
# VELOMINE__RATELIMITS__UPLOADSPERHOUR=600
# VELOMINE__RATELIMITS__UPLOADBURST=1000
# VELOMINE__RATELIMITS__IMPORTSPERDAY=10
# VELOMINE__RATELIMITS__CLUBCREATIONSPERDAY=5

# ---------------------------------------------------------------------------------------------------------------------
# Email. On when HOST and FROM are both set. Environment only: never stored in the database or shown in the app.
# ---------------------------------------------------------------------------------------------------------------------

# VELOMINE__SMTP__HOST=smtp.example.org
# VELOMINE__SMTP__FROM=Velomine <velomine@example.org>
# VELOMINE__SMTP__PORT=587
# starttls (port 587), ssl (port 465) or none (a local relay only)
# VELOMINE__SMTP__SECURITY=starttls
# VELOMINE__SMTP__USER=
# VELOMINE__SMTP__PASSWORD=

# ---------------------------------------------------------------------------------------------------------------------
# Single sign-on (any OpenID Connect provider). On when AUTHORITY is set. Environment only.
# Register https://<your host>/signin-oidc for the web client and com.velomine.app:/sso-callback for the phone.
# ---------------------------------------------------------------------------------------------------------------------

# VELOMINE__SSO__AUTHORITY=https://login.example.org
# The web client (the server completes the browser sign-in). The secret only if the provider requires one.
# VELOMINE__SSO__CLIENTID=
# VELOMINE__SSO__CLIENTSECRET=
# The phone's public client, with PKCE and no secret. Unset, the phone has no single sign-on.
# VELOMINE__SSO__APPCLIENTID=
# VELOMINE__SSO__DISPLAYNAME=Single sign-on
# false: only people who already have an account can sign in this way.
# VELOMINE__SSO__AUTOCREATEUSERS=true
# Scopes the phone asks for; the default is openid, profile and email.
# VELOMINE__SSO__APPSCOPES__0=openid
# Allows an http:// authority. Development only.
# VELOMINE__SSO__ALLOWINSECUREHTTP=false

# ---------------------------------------------------------------------------------------------------------------------
# Maps. Always on; an empty or unusable address falls back to OpenStreetMap.
# ---------------------------------------------------------------------------------------------------------------------

# VELOMINE__MAP__TILEURL=https://tiles.example.org/{z}/{x}/{y}.png
# VELOMINE__MAP__ATTRIBUTION=© Example tiles

# ---------------------------------------------------------------------------------------------------------------------
# Shared parts catalogue. Unset, the bundled list only, and nothing is sent.
# ---------------------------------------------------------------------------------------------------------------------

# VELOMINE__CATALOGUE__URL=
# VELOMINE__CATALOGUE__SYNCMINUTES=60
# Members' new parts go to the publisher only when both are set. The key is a secret.
# VELOMINE__CATALOGUE__CONTRIBUTEURL=
# VELOMINE__CATALOGUE__CONTRIBUTIONKEY=
# VELOMINE__CATALOGUE__CONTRIBUTEMINUTES=15
# Loads the bundled list into an empty catalogue. Leave it on; the tests turn it off.
# VELOMINE__CATALOGUE__SEED=true

# ---------------------------------------------------------------------------------------------------------------------
# Supporter licence. Off until the issuer's public key is set (tools/supporter-key.cs gen prints it).
# ---------------------------------------------------------------------------------------------------------------------

# VELOMINE__SUPPORTER__PUBLICKEY=

# ---------------------------------------------------------------------------------------------------------------------
# Background work. Exactly one instance runs it: set false on every other instance of the same deployment.
# ---------------------------------------------------------------------------------------------------------------------

# VELOMINE__BACKGROUND__ENABLED=true

# ---------------------------------------------------------------------------------------------------------------------
# Telemetry: the demo only; compose.development.yaml forces it off. Vendor-neutral, and off unless ENABLED is true and a
# destination is set. Members' apps send data only after they opt in; nothing carries member data.
# ---------------------------------------------------------------------------------------------------------------------

# VELOMINE__TELEMETRY__ENABLED=false
# The deployment name on every signal. Unset: Production.
# VELOMINE__TELEMETRY__ENVIRONMENT=demo
# Share of traces sent, 0 to 1. Errors are always reported.
# VELOMINE__TELEMETRY__TRACESAMPLERATIO=0.05

# Traces, metrics and logs over OTLP, to any OpenTelemetry backend (Grafana, SigNoz, Honeycomb, Elastic, ...).
# These are OpenTelemetry's own variables; copy the values from the backend's OTLP settings, for example:
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.example.org
#   OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer <key>
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# http/protobuf (works everywhere) or grpc (the exporter's default)
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Error reports: the DSN of an error-tracking service (GlitchTip, Bugsink or any compatible one). The server's project,
# then the app's; unset, the app uses the server's.
# VELOMINE__TELEMETRY__ERRORS__DSN=
# VELOMINE__TELEMETRY__APP__DSN=

# ---------------------------------------------------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------------------------------------------------

# Verbose, Debug, Information, Warning, Error or Fatal.
# Serilog__MinimumLevel__Default=Information
