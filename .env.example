# Every setting Velomine reads, with its default and what it does. Copy this file to .env next to docker-compose.yml and
# change what you need; .env is git-ignored and every variable in it reaches the server. A commented-out line keeps its
# default.
#
# Names: upper case, with __ for a nested setting (VELOMINE__SMTP__HOST is the server's Velomine:Smtp:Host).
# The defaults are for trying it out on your own machine only. Do not expose them to the internet: set the passwords and
# the public address first.

# ---------------------------------------------------------------------------------------------------------------------
# Compose: which files, which images, which port
# ---------------------------------------------------------------------------------------------------------------------

# The compose files plain `docker compose` commands use. Adding compose.demo.yaml puts Traefik (with Let's Encrypt) in
# front; the public demo runs exactly this.
# COMPOSE_FILE=docker-compose.yml:compose.demo.yaml

# The published images to run (ghcr.io/zenkraker/velomine-{server,web}), for example 0.1.0. Unset, `docker compose
# up --build` builds them from source as `dev`. Never `latest`. To upgrade or roll back, change it and run
# `docker compose pull && docker compose up -d --wait` again; `--wait` fails unless the server and the web app answer.
# VELOMINE_VERSION=0.1.0

# The host port of the web image. Not published with compose.demo.yaml, where Traefik answers on 80 and 443. With Dex,
# also change the redirect address in deploy/dex/config.yaml, and set VELOMINE__PUBLICURL to match.
# VELOMINE_PORT=8080

# compose.demo.yaml only, and required there: the app's host name (its DNS points at this server) and Let's Encrypt's
# contact, for expiry notices.
# VELOMINE_DOMAIN=demo.velomine.eu
# compose.demo.yaml only: a second host name for the presentation site, with its DNS on the same server. Each name then
# serves only its own part and redirects the other's paths to the other name, and / on VELOMINE_DOMAIN opens the app.
# Default: VELOMINE_DOMAIN.
# VELOMINE_SITE_DOMAIN=velomine.eu
# VELOMINE_ACME_EMAIL=ops@example.org

# ---------------------------------------------------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------------------------------------------------

# Set before the first start: the database keeps its first password afterwards.
POSTGRES_PASSWORD=change-me

# An existing PostgreSQL server instead of the postgres container. Unset, the server uses the container.
# CONNECTIONSTRINGS__VELOMINE=Host=db.example;Database=velomine;Username=velomine;Password=...

# ---------------------------------------------------------------------------------------------------------------------
# The server's address and first admin
# ---------------------------------------------------------------------------------------------------------------------

# The address members open, used in password reset emails and each member's calendar feed address. Set it to the public
# address, for example https://club.example; the incoming Host header is never used.
VELOMINE__PUBLICURL=http://localhost:8080

# The first admin, created on start while the server has none. Ignored afterwards. The password needs 10 characters
# or more with an upper-case letter, a lower-case letter and a digit, or the server stops on start with
# "Could not create the admin".
VELOMINE__ADMIN__EMAIL=admin@velomine.local
VELOMINE__ADMIN__PASSWORD=Change-me-1

# ---------------------------------------------------------------------------------------------------------------------
# Accounts and clubs
# ---------------------------------------------------------------------------------------------------------------------

# Whether new people can create an account.
# VELOMINE__ACCOUNTS__SIGNUPENABLED=true
# Off (the default), a rider signs up and starts the solo trial at once. On, new accounts wait for an admin. With email
# on, the address must still be confirmed before signing in.
# VELOMINE__ACCOUNTS__REQUIREADMINAPPROVAL=false
# Lets a rider without a club start one. Off, only the operator creates clubs.
# VELOMINE__ACCOUNTS__CLUBCREATIONENABLED=false
# An admin can also change all three in the app (Admin, Settings); a value saved there wins over the environment.

# ---------------------------------------------------------------------------------------------------------------------
# Background work. Ride processing, imports, email, catalogue sync, the first-admin setup and the timed jobs.
# With several server instances of one deployment, keep it on exactly one: set false on every other instance.
# ---------------------------------------------------------------------------------------------------------------------

# VELOMINE__BACKGROUND__ENABLED=true

# ---------------------------------------------------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------------------------------------------------

# Largest Strava export accepted, in MB. A large import needs free disk for the archive and one copy of every activity
# it brings in.
# VELOMINE__IMPORTS__MAXARCHIVEMB=1024

# Per address, a minute: sign-in, sign-up, two-factor, password reset and the phone's single sign-on.
# VELOMINE__RATELIMITS__ANONYMOUSPERMINUTE=60
# Per member: ride files an hour (sustained); a whole club behind one address does not share this budget.
# VELOMINE__RATELIMITS__UPLOADSPERHOUR=600
# Ride files one member may send at once, for example a whole bike computer folder.
# VELOMINE__RATELIMITS__UPLOADBURST=1000
# Strava exports one member may import in a day.
# VELOMINE__RATELIMITS__IMPORTSPERDAY=10
# Clubs one member may start in a day.
# VELOMINE__RATELIMITS__CLUBCREATIONSPERDAY=5

# ---------------------------------------------------------------------------------------------------------------------
# Email. On when HOST and FROM are both set. Environment only, by design: the password is never stored in the database
# or shown in the app. The admin Settings page shows the setup read-only, with "Send a test email". Without email,
# password reset answers that it is not available and an admin can make a one-time reset link.
# ---------------------------------------------------------------------------------------------------------------------

# The SMTP server, and the sender: a bare address, or a name and address in quotes,
# e.g. "Velomine <velomine@club.example>".
# VELOMINE__SMTP__HOST=smtp.example.org
# VELOMINE__SMTP__FROM=velomine@example.org
# VELOMINE__SMTP__PORT=587
# starttls (port 587), ssl (port 465) or none (a local relay only)
# VELOMINE__SMTP__SECURITY=starttls
# The SMTP login, if the server needs one.
# VELOMINE__SMTP__USER=
# VELOMINE__SMTP__PASSWORD=

# ---------------------------------------------------------------------------------------------------------------------
# Single sign-on (any OpenID Connect provider). On when AUTHORITY is set. Environment only, like email.
# In the provider, register https://<your host>/signin-oidc for the web client and com.velomine.app:/sso-callback for
# the phone.
# ---------------------------------------------------------------------------------------------------------------------

# The provider's issuer address.
# VELOMINE__SSO__AUTHORITY=https://login.example.org
# The web client (the server completes the browser sign-in). The secret only if the provider requires one.
# VELOMINE__SSO__CLIENTID=
# VELOMINE__SSO__CLIENTSECRET=
# The phone's public client, with PKCE and no secret. Unset, the phone has no single sign-on.
# VELOMINE__SSO__APPCLIENTID=
# The text of the sign-in button.
# VELOMINE__SSO__DISPLAYNAME=Single sign-on
# Off: only people who already have an account can sign in this way.
# VELOMINE__SSO__AUTOCREATEUSERS=true
# The scopes the phone asks for: __0, __1, ... and so on. The default is openid, profile and email; rarely needed.
# VELOMINE__SSO__APPSCOPES__0=openid
# VELOMINE__SSO__APPSCOPES__1=profile
# VELOMINE__SSO__APPSCOPES__2=email
# Allows an http:// authority. Development only.
# VELOMINE__SSO__ALLOWINSECUREHTTP=false

# ---------------------------------------------------------------------------------------------------------------------
# Maps. Always on: an empty or unusable address falls back to OpenStreetMap, so the map cannot be turned off.
# ---------------------------------------------------------------------------------------------------------------------

# A tile address with {z}, {x} and {y}, for example a private tile server, and the credit it requires.
# OpenStreetMap's public servers are for light use only: read their rules first.
# VELOMINE__MAP__TILEURL=https://tiles.example.org/{z}/{x}/{y}.png
# VELOMINE__MAP__ATTRIBUTION=© Example tiles

# ---------------------------------------------------------------------------------------------------------------------
# Shared parts catalogue. Unset, the server uses the parts list it ships with and sends nothing.
# ---------------------------------------------------------------------------------------------------------------------

# The publisher's full parts list, mirrored every SYNCMINUTES.
# VELOMINE__CATALOGUE__URL=
# How often to fetch it, 5 to 1440 minutes.
# VELOMINE__CATALOGUE__SYNCMINUTES=60
# Where parts members add are sent, and the key the publisher issued (a secret). Nothing is sent unless both are set;
# a contribution carries no member, bike, club or address.
# VELOMINE__CATALOGUE__CONTRIBUTEURL=
# VELOMINE__CATALOGUE__CONTRIBUTIONKEY=
# How often to send waiting contributions, 1 to 1440 minutes.
# VELOMINE__CATALOGUE__CONTRIBUTEMINUTES=15
# Loads the bundled list into an empty catalogue. Leave it on; the tests turn it off.
# VELOMINE__CATALOGUE__SEED=true

# ---------------------------------------------------------------------------------------------------------------------
# Supporter licence. Off until the issuer's ECDSA P-256 public key is set: base64 of the SPKI DER form, which
# `tools/supporter-key.cs gen` prints. A server without it works exactly the same, and a licence unlocks no feature.
# ---------------------------------------------------------------------------------------------------------------------

# VELOMINE__SUPPORTER__PUBLICKEY=

# ---------------------------------------------------------------------------------------------------------------------
# Telemetry. Off by default, and a self-hosted server sends nothing: nothing leaves unless ENABLED is true and a
# destination is set, and each destination is optional. Vendor-neutral: traces, metrics and logs go over OpenTelemetry's
# OTLP to any backend, error reports to the DSN of any compatible error-tracking service, such as GlitchTip or Bugsink.
# Telemetry carries no member data, and members' apps send data only after they opt in.
# The demo turns it on; compose.development.yaml forces it off.
# ---------------------------------------------------------------------------------------------------------------------

# The switch.
# VELOMINE__TELEMETRY__ENABLED=false
# The deployment name on every signal, for example demo. Unset: Production.
# VELOMINE__TELEMETRY__ENVIRONMENT=demo
# Share of traces sent, 0 to 1. Errors are always reported.
# VELOMINE__TELEMETRY__TRACESAMPLERATIO=0.05

# Traces, metrics and logs over OTLP, to any OpenTelemetry backend (Grafana, SigNoz, Honeycomb, Elastic, ...).
# These are OpenTelemetry's own variables, and the other standard OTEL_* ones work too; copy the values from the
# backend's OTLP settings, for example:
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.example.org
#   OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer <key>
# The endpoint; the headers the backend needs (usually its key); http/protobuf (works everywhere) or grpc (the
# exporter's default).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Error reports: the DSN of an error-tracking service (GlitchTip, Bugsink or any compatible one). The server's project,
# then the app's (where opted-in apps send crash reports); unset, the app uses the server's.
# VELOMINE__TELEMETRY__ERRORS__DSN=
# VELOMINE__TELEMETRY__APP__DSN=

# ---------------------------------------------------------------------------------------------------------------------
# Logs. How much the server logs; logs never contain ride or health data, names, email or IP addresses.
# ---------------------------------------------------------------------------------------------------------------------

# Verbose, Debug, Information, Warning, Error or Fatal.
# Serilog__MinimumLevel__Default=Information
